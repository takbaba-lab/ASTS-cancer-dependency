#!/bin/bash

#PJM -L rscgrp=a-batch
#PJM -L vnode-core=4
#PJM -L elapse=2:00:00
#PJM -j
#PJM -S

# ============================================================
# ASTRA-Drug
# 05: normalization + DESeq2 batch job
# ============================================================


# ------------------------------------------------------------
# Path / Parameter
# ------------------------------------------------------------

PROJECT_DIR="${ASTRA_PROJECT_DIR:-$PWD}"

SCRIPT="${PROJECT_DIR}/scripts/05_normalization_DESeq2.R"

N_THREADS=4


# ------------------------------------------------------------
# Error handling
# ------------------------------------------------------------

set -eo pipefail


# ------------------------------------------------------------
# micromamba
# ------------------------------------------------------------

source "${HOME}/.bashrc" || true

eval "$(micromamba shell hook --shell bash)"

micromamba activate astra-r


set -u


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

export OMP_NUM_THREADS="${N_THREADS}"
export OPENBLAS_NUM_THREADS="${N_THREADS}"
export MKL_NUM_THREADS="${N_THREADS}"


cd "${PROJECT_DIR}"


trap 'rc=$?; echo "End: $(date -Is) / exit_code=${rc}"' EXIT


# ------------------------------------------------------------
# Job information
# ------------------------------------------------------------

echo "============================================================"
echo "ASTRA-Drug 05 normalization + DESeq2"
echo "============================================================"

echo "Start: $(date -Is)"
echo "Host: $(hostname)"
echo "Working directory: $(pwd)"

echo ""

echo "R version:"
R --version | head -n 1

echo ""

echo "DESeq2 version:"
Rscript -e 'cat(as.character(packageVersion("DESeq2")), "\n")'

echo ""


# ------------------------------------------------------------
# Run
# ------------------------------------------------------------

Rscript "${SCRIPT}"


echo ""
echo "============================================================"
echo "05 job successfully finished"
echo "============================================================"
