#!/bin/bash

#PJM -L rscgrp=a-batch
#PJM -L vnode-core=4
#PJM -L elapse=6:00:00
#PJM -j
#PJM -S

# ============================================================
# ASTRA-Drug
# Step 17
# Genome-wide CRISPR dependency landscape
# ============================================================


# ============================================================
# Path / Parameter
# ============================================================

PROJECT_DIR="${ASTRA_PROJECT_DIR:-$PWD}"

SCRIPT_A="${PROJECT_DIR}/scripts/17a_CRISPR_genomewide_ASTS.py"

SCRIPT_B="${PROJECT_DIR}/scripts/17b_CRISPR_dependency_GSEA.R"

N_THREADS=4


# ============================================================
# Error handling
# ============================================================

set -eo pipefail


# ============================================================
# Environment
# ============================================================

source "${HOME}/.bashrc" || true

eval "$(micromamba shell hook --shell bash)"

set -u


export OMP_NUM_THREADS="${N_THREADS}"
export OPENBLAS_NUM_THREADS="${N_THREADS}"
export MKL_NUM_THREADS="${N_THREADS}"
export NUMEXPR_NUM_THREADS="${N_THREADS}"
export MPLBACKEND=Agg


# ============================================================
# Run
# ============================================================

cd "${PROJECT_DIR}"


trap \
'rc=$?; echo "End: $(date -Is) / exit_code=${rc}"' \
EXIT


echo "============================================================"
echo "ASTRA-Drug Step 17"
echo "Genome-wide CRISPR dependency landscape"
echo "============================================================"

echo "Start: $(date -Is)"
echo "Host: $(hostname)"
echo ""


echo "Step 17A: genome-wide CRISPR association"

micromamba run \
    -n astra-py \
    python -u \
    "${SCRIPT_A}"


echo ""
echo "Step 17B: dependency GSEA"

micromamba run \
    -n astra-pathway-r \
    Rscript \
    "${SCRIPT_B}"


echo ""
echo "============================================================"
echo "Step 17 successfully finished"
echo "============================================================"