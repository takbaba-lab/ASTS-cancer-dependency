#!/bin/bash

#PJM -L rscgrp=a-batch
#PJM -L vnode-core=4
#PJM -L elapse=4:00:00
#PJM -j
#PJM -S

# ============================================================
# ASTRA-Drug
# Step 09: PRISM × ASTS association
# ============================================================


# ------------------------------------------------------------
# Path / Parameter
# ------------------------------------------------------------

PROJECT_DIR="${ASTRA_PROJECT_DIR:-$PWD}"

SCRIPT="${PROJECT_DIR}/scripts/09b_PRISM_ASTS_association.py"

N_THREADS=4


# ------------------------------------------------------------
# Error handling
# ------------------------------------------------------------

set -eo pipefail


# ------------------------------------------------------------
# micromamba
# ------------------------------------------------------------

source "${HOME}/.bashrc" || true

eval "$(micromamba shell hook --shell bash)"

micromamba activate astra-py

set -u


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

export OMP_NUM_THREADS="${N_THREADS}"
export OPENBLAS_NUM_THREADS="${N_THREADS}"
export MKL_NUM_THREADS="${N_THREADS}"
export NUMEXPR_NUM_THREADS="${N_THREADS}"
export MPLBACKEND=Agg


# ------------------------------------------------------------
# Run
# ------------------------------------------------------------

cd "${PROJECT_DIR}"

trap 'rc=$?; echo "End: $(date -Is) / exit_code=${rc}"' EXIT


echo "============================================================"
echo "ASTRA-Drug Step 09"
echo "PRISM x ASTS association"
echo "============================================================"

echo "Start: $(date -Is)"
echo "Host: $(hostname)"
echo "PWD: $(pwd)"

echo ""

echo "Python:"
python --version

echo ""

echo "statsmodels:"
python -c \
'import statsmodels; print(statsmodels.__version__)'

echo ""

echo "Script checksum:"
sha256sum "${SCRIPT}"

echo ""


python -u "${SCRIPT}"


echo ""
echo "============================================================"
echo "09 successfully finished"
echo "============================================================"