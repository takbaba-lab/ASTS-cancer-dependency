#!/bin/bash

#PJM -L rscgrp=a-batch
#PJM -L vnode-core=4
#PJM -L elapse=3:00:00
#PJM -j
#PJM -S

# ============================================================
# ASTRA-Drug
# Step 14A: ASTS-associated transcriptome
# ============================================================

# ------------------------------------------------------------
# Path / Parameter
# ------------------------------------------------------------

PROJECT_DIR="${ASTRA_PROJECT_DIR:-$PWD}"

SCRIPT="${PROJECT_DIR}/scripts/14a_ASTS_transcriptome.py"


# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------

set -eo pipefail

source "${HOME}/.bashrc" || true

eval "$(micromamba shell hook --shell bash)"

micromamba activate astra-py

set -u

export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4


# ------------------------------------------------------------
# Run
# ------------------------------------------------------------

cd "${PROJECT_DIR}"

trap 'rc=$?; echo "End: $(date -Is) / exit_code=${rc}"' EXIT

echo "Start: $(date -Is)"
echo "Host: $(hostname)"

python --version

sha256sum "${SCRIPT}"

python -u "${SCRIPT}"